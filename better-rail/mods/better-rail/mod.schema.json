{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Better Rail mod.json",
  "description": "What Herdr reads from Better Rail's mod.json.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's schema, for editors."
    },
    "version": {
      "type": "string",
      "description": "The mod's version."
    },
    "title": {
      "type": "string",
      "description": "The mod's name, as Herdr shows it."
    },
    "place": {
      "enum": [
        "left",
        "right",
        "top",
        "bottom",
        "none"
      ],
      "description": "Where Herdr first docks the mod. \"none\": only where a layout or another mod puts it."
    },
    "size": {
      "type": "number",
      "minimum": 0,
      "description": "Its first size, in pixels."
    },
    "focusable": {
      "type": "boolean",
      "description": "Lets pane.go give a shown copy the keyboard."
    },
    "overlay": {
      "type": "object",
      "description": "How mod.open shows it.",
      "properties": {
        "kind": {
          "enum": [
            "dialog",
            "popup",
            "window"
          ]
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "settings": {
      "type": "object",
      "description": "Your changes. A setting left out uses its default.",
      "additionalProperties": false,
      "properties": {
        "order": {
          "title": "Icon order",
          "description": "Button ids in the order to show them, such as files, changes, editor. Ids you leave out follow in the layout's order.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    }
  }
}
